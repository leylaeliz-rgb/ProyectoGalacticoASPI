{
  "AllowedHosts": "*",
  "Jwt": {
    "Emisor": "ProyectoGalactico",
    "Audiencia": "ProyectoGalacticoClientes",
    "MinutosExpiracion": 30
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:HH:mm:ss.fff} {Level:u3} cid={CorrelationId} ip={ClientIp} fp={Fingerprint} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/proyectoGalactico-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} {Level:u3} cid={CorrelationId} ip={ClientIp} ua=[{UserAgent}] fp={Fingerprint} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Cors": {
  "Origen": "http://localhost:4200"
  }
}
